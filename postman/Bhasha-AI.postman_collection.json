            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "pm.test('Unknown email login returns HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Unknown email uses safe generic error', () => pm.expect(body.error).to.eql('Invalid email or password'));"
            ]}
          }]
        },
        {
          "name": "Login returns a JWT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "pm.test('Valid login returns HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Login marks success', () => pm.expect(body.success).to.eql(true));",
              "pm.test('Login returns a JWT', () => pm.expect(body.access_token).to.be.a('string').and.not.empty);",
              "pm.test('Login returns the correct user', () => pm.expect(body.user.email).to.eql(pm.collectionVariables.get('testEmail')));",
              "pm.test('Login response omits password hash', () => pm.expect(body.user).not.to.have.property('password_hash'));",
              "pm.collectionVariables.set('accessToken', body.access_token);"
            ]}
          }]
        },
        {
          "name": "Current user rejects missing JWT",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"

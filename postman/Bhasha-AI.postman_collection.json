            "url": "{{baseUrl}}/api/history"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "pm.test('Malformed history JWT returns HTTP 422', () => pm.response.to.have.status(422));",
              "pm.test('Malformed history JWT returns parser message', () => pm.expect(body.msg).to.be.a('string').and.not.empty);"
            ]}
          }]
        },
        {
          "name": "Save history entry",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"feature_type\": \"postman_verification\",\n  \"feature_data\": {\n    \"marker\": \"{{historyMarker}}\",\n    \"source\": \"newman\"\n  }\n}" },
            "url": "{{baseUrl}}/api/history"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "pm.test('History save returns HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('History save marks success', () => pm.expect(body.success).to.eql(true));",
              "pm.test('History save returns confirmation', () => pm.expect(body.message).to.eql('History saved'));",
              "pm.test('Saved history retains feature type', () => pm.expect(body.history.feature_type).to.eql('postman_verification'));",
              "pm.test('Saved history retains marker', () => pm.expect(body.history.feature_data.marker).to.eql(pm.collectionVariables.get('historyMarker')));"
            ]}
          }]
        },
        {
          "name": "Retrieve saved history",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/history"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "const marker = pm.collectionVariables.get('historyMarker');",
              "const match = body.history.find((entry) => entry.feature_data && entry.feature_data.marker === marker);",
              "pm.test('History retrieval returns HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('History retrieval marks success', () => pm.expect(body.success).to.eql(true));",
              "pm.test('History retrieval returns an array', () => pm.expect(body.history).to.be.an('array'));",
              "pm.test('History retrieval contains saved marker', () => pm.expect(match).to.be.an('object'));",
              "pm.test('Retrieved history includes timestamp', () => pm.expect(match.created_at).to.be.a('string').and.not.empty);"
            ]}
          }]
        }
      ]
    },

{
  "info": {
    "_postman_id": "0ae711ea-8ae4-4fc3-bc8f-bhasha-api",
    "name": "Bhasha AI - Local API Verification",
    "description": "Local, quota-free verification of Bhasha AI's Flask API. Request count and pm.test assertion count must be reported separately.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  const runId = `${Date.now()}-${Math.floor(Math.random() * 100000)}`;",
          "  pm.collectionVariables.set('runId', runId);",
          "  pm.collectionVariables.set('testEmail', `bhasha.newman.${runId}@example.test`);",
          "  pm.collectionVariables.set('testPassword', 'Postman-Test-Password-42!');",
          "  pm.collectionVariables.set('historyMarker', `postman-history-${runId}`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "runId", "value": "" },
    { "key": "testEmail", "value": "" },
    { "key": "testPassword", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "historyMarker", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Health returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Health response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Health payload is an object', () => pm.expect(body).to.be.an('object'));",
                  "pm.test('Health status is ok', () => pm.expect(body.status).to.eql('ok'));",
                  "pm.test('Health message identifies backend', () => pm.expect(body.message).to.eql('Backend is running'));",
                  "pm.test('ElevenLabs configuration flag is boolean', () => pm.expect(body.elevenlabs_configured).to.be.a('boolean'));",
                  "pm.test('Gemini configuration flag is boolean', () => pm.expect(body.gemini_configured).to.be.a('boolean'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Signup rejects missing fields",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Only a name\"\n}" },
            "url": "{{baseUrl}}/api/auth/signup"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "pm.test('Incomplete signup returns HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Incomplete signup explains required fields', () => pm.expect(body.error).to.eql('Name, email, and password are required'));"
            ]}
          }]
        },
        {
          "name": "Signup rejects empty JSON",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/api/auth/signup"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "pm.test('Empty signup returns HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Empty signup reports required fields', () => pm.expect(body.error).to.eql('Name, email, and password are required'));"
            ]}
          }]
        },
        {
          "name": "Signup creates a unique user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Verification User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/signup"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "pm.test('Valid signup returns HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Signup marks success', () => pm.expect(body.success).to.eql(true));",
              "pm.test('Signup returns confirmation message', () => pm.expect(body.message).to.eql('User created successfully'));",
              "pm.test('Signup returns a JWT', () => pm.expect(body.access_token).to.be.a('string').and.not.empty);",
              "pm.test('Signup returns the requested email', () => pm.expect(body.user.email).to.eql(pm.collectionVariables.get('testEmail')));",
              "pm.test('Signup returns a numeric user id', () => pm.expect(body.user.id).to.be.a('number'));",
              "pm.collectionVariables.set('accessToken', body.access_token);"
            ]}
          }]
        },
        {
          "name": "Signup rejects duplicate email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/signup"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "pm.test('Duplicate signup returns HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Duplicate signup identifies existing email', () => pm.expect(body.error).to.eql('Email already exists'));"
            ]}
          }]
        },
        {

          "name": "Current user rejects malformed JWT",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer not-a-valid-jwt" }],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "pm.test('Malformed JWT returns HTTP 422', () => pm.response.to.have.status(422));",
              "pm.test('Malformed JWT returns parser message', () => pm.expect(body.msg).to.be.a('string').and.not.empty);"
            ]}
          }]
        },
        {
          "name": "Current user accepts valid JWT",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const body = pm.response.json();",
              "pm.test('Valid JWT user lookup returns HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('User lookup marks success', () => pm.expect(body.success).to.eql(true));",
              "pm.test('User lookup returns correct email', () => pm.expect(body.user.email).to.eql(pm.collectionVariables.get('testEmail')));",
              "pm.test('User lookup returns account creation timestamp', () => pm.expect(body.user.created_at).to.be.a('string').and.not.empty);"
            ]}
          }]
        }
      ]
    },

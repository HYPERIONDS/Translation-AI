# Bhasha AI - Environment Variables
# Copy this file to .env and add your actual API keys

# ElevenLabs API Key (for AI voice generation)
# Get it from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Gemini API Key (for translation)
# Get it from: https://ai.google.dev/
GEMINI_API_KEY=your_google_gemini_api_key_here

# JWT Secret Key (for authentication)
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_random_secret_key_here

# Flask Configuration
FLASK_ENV=development
